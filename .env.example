# Replace example.org with the active base domain before enabling the proxy.
BASE_DOMAIN=example.org
ENGINE_DOMAIN=engine.example.org
BANK_DOMAIN=bank.example.org
STORE_DOMAIN=store.example.org
ADMIN_DOMAIN=admin.example.org
COOKIE_DOMAIN=

# Setup script generates strong values for these.
SECRET_KEY=replace-this-before-deployment
CHECK_CREDENTIAL_KEY=replace-this-with-64-hex-characters
POSTGRES_PASSWORD=replace-this-before-deployment

# Public HTTP/HTTPS ports for Caddy.
HTTP_PORT=80
HTTPS_PORT=443
SESSION_COOKIE_SECURE=false

# Parallel service probes per scoring worker container.
# Scale scoring-worker containers with: docker compose up -d --scale scoring-worker=N scoring-worker
SCORING_THREADS=8
SCORING_TICK_SECONDS=15
DEFAULT_PAYOUT_PER_POINT=10
